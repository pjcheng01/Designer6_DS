# ---- Windows 檔案總管 ----
Thumbs.db
ehthumbs.db
desktop.ini

# ---- 網路磁碟/掛載殘留 ----
.fuse_hidden*

# ---- DraftSight / AutoCAD 暫存、鎖定、自動存檔 ----
*.dwl
*.dwl2
*.sv$
*.ac$
*.err

# ---- CAMPRO / BOM 執行期輸出 ----
campro.txt
CamproBom.txt
CamproPdm.txt
bom.out
# 拆圖(c:out)寫出的 manadwg 轉檔檔，目前無人讀取
data.txt
# selfile.exe 寫出的多檔選擇結果，每次使用都不同
TRANS/filelist.txt
pdmbom3.txt

# ---- 程式產生後隨即執行的暫時 script ----
# 沒有前置斜線，所以任何層級都擋（openfile.scr 會出現在 ITEM* 各目錄下）。
# 注意根目錄的 openfile.scr 從原始匯入起就已納入版控，.gitignore 不會讓
# 已追蹤的檔案脫離追蹤；要退出版控需另外 git rm --cached。
delfile.scr
openfile.scr
# btplot.scr 是批次出圖產生的 script，跑完就沒用了。2026-09-14 取消納管；
# 原本 HEAD 裡存的是 2003 年的執行殘留，指向早已不存在的 \\W2000s2\powertech\...
btplot.scr
BTPLOT.SCR

# ---- ini 寫回時的中繼檔 ----
# file_update 與 c:defbom 的流程是 xxx.ini -> 中繼檔 -> xxx.ini，
# 每次用到那些設定對話框都會重寫，不該進版控。
system.swr
SYSTEM.NEW
# 注意大小寫：實際檔名是 SWAPFILE.TXT，git 的索引是區分大小寫的，
# 只寫小寫不會擋到它（而且它本來就已納管，要先 git rm --cached）。
swapfile.txt
SWAPFILE.TXT

# ---- 手動備份檔 ----
*.bak
*.bak_*
*.orig

# ---- Python 工具的產物 ----
__pycache__/
*.pyc

# ---- 執行期產生的使用者設定 ----
# DFSYSTEM.lsp 的 wr_osmode_to_supp 會在 get_support_path() 下建立 osmode.ini，
# 存「鎖點模式組」O1~O5 的五組設定。第一次執行 &setosmode 或 O1~O5 時自動產生，
# 內容因人而異，不該進版控。詳見手冊 §5.27。
osmode.ini
