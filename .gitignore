# ---- Windows 檔案總管 ----
Thumbs.db
ehthumbs.db
desktop.ini

# ---- 網路磁碟/掛載殘留 ----
.fuse_hidden*

# ---- DraftSight / AutoCAD 暫存、鎖定、自動存檔 ----
*.dwl
*.dwl2
*.sv$
*.ac$
*.err

# ---- CAMPRO / BOM 執行期輸出 ----
campro.txt
CamproBom.txt
bom.out
pdmbom3.txt

# ---- ini 寫回時的中繼檔 ----
# file_update 與 c:defbom 的流程是 xxx.ini -> 中繼檔 -> xxx.ini，
# 每次用到那些設定對話框都會重寫，不該進版控。
system.swr
SYSTEM.NEW
swapfile.txt

# ---- 手動備份檔 ----
*.bak
*.bak_*
*.orig

# ---- Python 工具的產物 ----
__pycache__/
*.pyc
